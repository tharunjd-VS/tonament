{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/cron/hourly",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "31 3 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/t/:path*",
      "destination": "/api/index?__path=share/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__path=sitemap"
    },
    {
      "source": "/:sport(badminton|pickleball|table-tennis|squash|tennis|padel|volleyball|beach-volleyball|throwball|sepak-takraw|snooker|pool|carrom|football|futsal|hockey|kabaddi|basketball)",
      "destination": "/api/index?__path=sport/:sport"
    },
    {
      "source": "/tools",
      "destination": "/api/index?__path=tools"
    },
    {
      "source": "/tools/:slug([a-z-]+)",
      "destination": "/api/index?__path=tools/:slug"
    },
    {
      "source": "/blog",
      "destination": "/api/index?__path=blog"
    },
    {
      "source": "/blog/rss.xml",
      "destination": "/api/index?__path=blog/rss.xml"
    },
    {
      "source": "/blog/tag/:tag([a-z0-9-]+)",
      "destination": "/api/index?__path=blog/tag/:tag"
    },
    {
      "source": "/blog/:slug([a-z0-9-]+)",
      "destination": "/api/index?__path=blog/:slug"
    },
    {
      "source": "/:sport(badminton|pickleball|table-tennis|squash|tennis|padel|volleyball|beach-volleyball|throwball|sepak-takraw|snooker|pool|carrom|football|futsal|hockey|kabaddi|basketball)/:city([a-z0-9-]+)",
      "destination": "/api/index?__path=city/:sport/:city"
    },
    {
      "source": "/sports",
      "destination": "/api/index?__path=sport"
    },
    {
      "source": "/@:slug/edit",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/@:slug",
      "destination": "/api/index?__path=org/:slug"
    },
    {
      "source": "/academy/new",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/clubs",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/club-run/:id(\\d{1,12})",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/race/:id(\\d{1,12})",
      "destination": "/api/index?__path=racepage/:id"
    },
    {
      "source": "/meet/:id(\\d{1,12})",
      "destination": "/api/index?__path=meetpage/:id"
    },
    {
      "source": "/champ/:id(\\d{1,12})",
      "destination": "/api/index?__path=champpage/:id"
    },
    {
      "source": "/champs",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/champs/new",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/meets",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/meets/new",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/races",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/races/new",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/play",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/compete",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/you",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/runs",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/goals",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/goals/:id(\\d{1,12})",
      "destination": "/api/index?__path=goalpage/:id"
    },
    {
      "source": "/goals/:path*",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/challenges",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/challenges/:path*",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/season/:id(\\d{1,12})",
      "destination": "/api/index?__path=seasonpage/:id"
    },
    {
      "source": "/cc/:id(\\d{1,12})",
      "destination": "/api/index?__path=ccpage/:id"
    },
    {
      "source": "/c/:id(\\d{1,12})",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/clubs/:path*",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/club/:slug",
      "destination": "/api/index?__path=clubpage/:slug"
    },
    {
      "source": "/a/:id(\\d{1,12})",
      "destination": "/api/index?__path=item/:id"
    },
    {
      "source": "/img/:kind(a|club|p|t|ladder|goal|cc|season|race|meet|champ)/:file",
      "destination": "/api/index?__path=img/:kind/:file"
    },
    {
      "source": "/me/profile",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/groups/:path*",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/groups",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/g/:slug([a-z0-9-]{3,40})",
      "destination": "/api/index?__path=group/:slug"
    },
    {
      "source": "/g/:path*",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/p/:handle",
      "destination": "/api/index?__path=player/:handle"
    },
    {
      "source": "/rankings",
      "destination": "/api/index?__path=rankings"
    },
    {
      "source": "/rankings/:path*",
      "destination": "/api/index?__path=rankings/:path*"
    },
    {
      "source": "/:page(new|invite|signin|signup|forgot|reset|link|admin|notifications)",
      "destination": "/api/index?__path=app"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 10,
      "includeFiles": "{public/index.html,public/app.js,public/styles.css,public/brand/logo-white.svg,server/fonts/**,content/**}"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ]
}
