{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/t/:path*",
      "destination": "/api/index?__path=share/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__path=sitemap"
    },
    {
      "source": "/:page(new|signin|signup|forgot|reset|admin)",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 10,
      "includeFiles": "public/index.html"
    }
  }
}
