{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/t/:path*",
      "destination": "/api/index?__path=share/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__path=sitemap"
    },
    {
      "source": "/:sport(badminton|pickleball|table-tennis|squash|tennis|padel|volleyball|beach-volleyball|throwball|sepak-takraw)",
      "destination": "/api/index?__path=sport/:sport"
    },
    {
      "source": "/sports",
      "destination": "/api/index?__path=sport"
    },
    {
      "source": "/@:slug/edit",
      "destination": "/index.html"
    },
    {
      "source": "/@:slug",
      "destination": "/api/index?__path=org/:slug"
    },
    {
      "source": "/academy/new",
      "destination": "/index.html"
    },
    {
      "source": "/me/profile",
      "destination": "/index.html"
    },
    {
      "source": "/p/:handle",
      "destination": "/api/index?__path=player/:handle"
    },
    {
      "source": "/rankings",
      "destination": "/api/index?__path=rankings"
    },
    {
      "source": "/rankings/:path*",
      "destination": "/api/index?__path=rankings/:path*"
    },
    {
      "source": "/:page(new|signin|signup|forgot|reset|admin)",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__path=:path*"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 10,
      "includeFiles": "public/index.html"
    }
  }
}
